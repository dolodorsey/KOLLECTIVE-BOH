# ============================================================
# THE KOLLECTIVE — BOH APP
# Deployed on Vercel. Backend = Supabase. No Rork, no Replit, no n8n.
# ============================================================

# --- Supabase ---
# DEFAULT: the KHG gateway project, same backend as thedoctordorsey.com.
EXPO_PUBLIC_SUPABASE_URL=https://dzlmtvodpyhetvektfuo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The BOH app was originally built against its own Supabase project
# (credential key: supabase_kollective_boh). If that project still holds
# production data, point the two vars above at it instead and plan the
# migration into the gateway deliberately — do not run both silently.

# --- API ---
# Web builds call /api on their own origin and ignore this.
# Native (Capacitor/EAS) builds need the deployed BOH origin.
EXPO_PUBLIC_API_URL=https://thekollectivegroup.com

# --- Automation ---
# Supabase Edge Functions. Replaces the dead n8n webhook layer.
EXPO_PUBLIC_AUTOMATION_URL=https://dzlmtvodpyhetvektfuo.supabase.co/functions/v1

