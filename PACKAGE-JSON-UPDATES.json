{
  "name": "kollective-boh",
  "description": "Add these dependencies to your existing package.json",
  "dependencies": {
    "expo-device": "~7.0.6",
    "expo-notifications": "~1.0.6",
    "lucide-react-native": "^0.468.0"
  },
  "notes": {
    "expo-device": "Required for device detection in push notification setup",
    "expo-notifications": "Expo's push notification library",
    "lucide-react-native": "Icons for enhanced dashboard (TrendingUp, Activity, etc.)"
  },
  "installation": {
    "command": "bun add expo-device expo-notifications lucide-react-native",
    "or": "npm install expo-device expo-notifications lucide-react-native"
  },
  "configuration": {
    "app.json": {
      "expo": {
        "notification": {
          "icon": "./assets/notification-icon.png",
          "color": "#FFD700",
          "androidMode": "default",
          "androidCollapsedTitle": "KOLLECTIVE"
        },
        "android": {
          "useNextNotificationsApi": true,
          "googleServicesFile": "./google-services.json"
        },
        "ios": {
          "supportsTablet": true,
          "bundleIdentifier": "com.kollective.boh"
        },
        "plugins": [
          [
            "expo-notifications",
            {
              "icon": "./assets/notification-icon.png",
              "color": "#FFD700",
              "sounds": ["./assets/notification.wav"],
              "mode": "production"
            }
          ]
        ]
      }
    }
  },
  "setup_steps": [
    "1. Add dependencies: bun add expo-device expo-notifications lucide-react-native",
    "2. Create notification icon: 96x96px PNG at assets/notification-icon.png",
    "3. Update app.json with notification config (see configuration above)",
    "4. Copy lib/push-notifications.ts to your project",
    "5. Run SQL: PUSH-NOTIFICATIONS-SCHEMA.sql in Supabase",
    "6. Integrate in App.tsx (see IMPLEMENTATION-GUIDE.md)",
    "7. Test on physical device (push doesn't work in simulator)"
  ]
}
